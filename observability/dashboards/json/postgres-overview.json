{
  "title": "PostgreSQL Overview",
  "uid": "postgres-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Up",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pg_up", "legendFormat": "postgres", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Active Connections",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"tasting_journals\"}",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Transaction Rate",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 0 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"tasting_journals\"}[5m])",
          "legendFormat": "commits/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"tasting_journals\"}[5m])",
          "legendFormat": "rollbacks/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "title": "Cache Hit Ratio",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit{datname=\"tasting_journals\"}[5m]) / (rate(pg_stat_database_blks_hit{datname=\"tasting_journals\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"tasting_journals\"}[5m]))",
          "legendFormat": "cache hit ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rows Read/Written",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"tasting_journals\"}[5m])",
          "legendFormat": "fetched/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_tup_inserted{datname=\"tasting_journals\"}[5m])",
          "legendFormat": "inserted/s",
          "refId": "B"
        },
        {
          "expr": "rate(pg_stat_database_tup_updated{datname=\"tasting_journals\"}[5m])",
          "legendFormat": "updated/s",
          "refId": "C"
        },
        {
          "expr": "rate(pg_stat_database_tup_deleted{datname=\"tasting_journals\"}[5m])",
          "legendFormat": "deleted/s",
          "refId": "D"
        }
      ]
    }
  ]
}
